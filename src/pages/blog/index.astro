---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { postPath } from '../../paths';
import { SITE } from '../../site.config';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
	title="Blog"
	description={`Notas técnicas, aprendizajes y bitácoras de ${SITE.name}.`}
	heading="Blog"
	intro="Lo que aprendo, lo que rompo y lo que me cuesta. Escrito para quien viene después."
	mainClass="blog-index"
>
	{
		posts.length === 0 ? (
			<p class="empty">Todavía no hay posts. Vuelve pronto.</p>
		) : (
			<ul class="post-list">
				{posts.map((post, index) => (
					<li class:list={['post-card', { 'post-card--featured': index === 0 }]}>
						<a href={postPath(post.id)}>
							{post.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={post.data.heroImage}
									alt=""
									loading={index === 0 ? 'eager' : 'lazy'}
								/>
							)}
							<h2 class="post-card__title">{post.data.title}</h2>
							<p class="post-card__description">{post.data.description}</p>
							<p class="post-card__date">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.blog-index {
		width: 960px;
	}

	.empty {
		color: rgb(var(--gray));
		text-align: center;
		padding: 3rem 0;
	}

	.post-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-card a {
		display: block;
		text-decoration: none;
		transition: 0.2s ease;
	}

	.post-card img {
		margin-bottom: 0.9rem;
		border-radius: 12px;
		width: 100%;
		transition: box-shadow 0.2s ease;
	}

	.post-card a:hover img {
		box-shadow: var(--box-shadow);
	}

	.post-card__title {
		margin: 0 0 0.4rem;
		font-size: 1.35rem;
		line-height: 1.25;
		transition: color 0.2s ease;
	}

	.post-card a:hover .post-card__title {
		color: var(--accent);
	}

	.post-card__description {
		margin: 0 0 0.6rem;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}

	.post-card__date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}

	.post-card--featured {
		grid-column: 1 / -1;
		text-align: center;
	}

	.post-card--featured .post-card__title {
		font-size: clamp(1.6rem, 4vw, 2.2rem);
	}
</style>
