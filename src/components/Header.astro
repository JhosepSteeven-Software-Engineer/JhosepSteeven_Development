---
import { SITE } from '../site.config';
import { paths } from '../paths';
import SocialLinks from './SocialLinks.astro';

const navItems = [
	{ href: paths.home, label: 'Inicio' },
	{ href: paths.blog, label: 'Blog' },
	{ href: paths.about, label: 'Sobre mí' },
];

const rawBase = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.replace(rawBase, '') || '/';

/** Marca el enlace activo comparando el prefijo de la ruta (sin el `base`). */
const isActive = (href: string) => {
	const clean = href.replace(rawBase, '').replace(/\/+$/, '') || '/';
	return clean === '/' ? pathname === '/' : pathname.startsWith(clean);
};
---

<header>
	<nav aria-label="Principal">
		<a class="brand" href={paths.home}>
			<span class="brand__mark" aria-hidden="true">&lt;/&gt;</span>
			<span class="brand__text">{SITE.name}</span>
		</a>

		<button
			class="nav-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="Abrir menú de navegación"
		>
			<span class="nav-toggle__bar"></span>
			<span class="nav-toggle__bar"></span>
			<span class="nav-toggle__bar"></span>
		</button>

		<div class="nav-panel" id="site-nav">
			<ul class="internal-links">
				{
					navItems.map((item) => (
						<li>
							<a href={item.href} class:list={{ active: isActive(item.href) }}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>

			<div class="social-links">
				<span class="social-links__label">Encuéntrame en</span>
				<SocialLinks />
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: sticky;
		top: 0;
		z-index: 50;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 960px;
		margin: 0 auto;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
		padding: 0.9rem 0;
	}

	.brand__mark {
		font-family: monospace;
		color: var(--accent);
	}

	.brand__text {
		font-size: 1em;
	}

	/* --- Botón de menú (solo móvil) --- */
	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 42px;
		height: 42px;
		padding: 0 9px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: #fff;
		cursor: pointer;
	}

	.nav-toggle__bar {
		display: block;
		height: 2px;
		width: 100%;
		background: rgb(var(--gray-dark));
		border-radius: 2px;
		transition: transform 0.25s ease, opacity 0.2s ease;
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* --- Panel de navegación --- */
	.nav-panel {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.internal-links a {
		display: inline-block;
		padding: 1em 0.6em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	.internal-links a:hover {
		color: var(--accent);
	}

	.internal-links a.active {
		border-bottom-color: var(--accent);
		font-weight: 700;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.social-links__label {
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}

	/* --- Móvil --- */
	@media (max-width: 760px) {
		.nav-toggle {
			display: flex;
		}

		.nav-panel {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem 1rem 1rem;
			background: #fff;
			box-shadow: 0 12px 24px rgba(var(--gray), 25%);
			border-bottom: 1px solid rgb(var(--gray-light));
			display: none;
		}

		.nav-panel.is-open {
			display: flex;
		}

		.internal-links {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}

		.internal-links a {
			padding: 0.85rem 0.25rem;
			border-bottom: 1px solid rgb(var(--gray-light));
		}

		.internal-links a.active {
			border-bottom-color: rgb(var(--gray-light));
			border-left: 3px solid var(--accent);
			padding-left: 0.6rem;
		}

		.social-links {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
			padding-top: 1rem;
		}

		.social-links :global(.social-list) {
			gap: 0.9rem;
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const panel = document.querySelector<HTMLElement>('.nav-panel');

	if (toggle && panel) {
		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!isOpen));
			toggle.setAttribute(
				'aria-label',
				isOpen ? 'Abrir menú de navegación' : 'Cerrar menú de navegación',
			);
			panel.classList.toggle('is-open', !isOpen);
		});

		// Cierra el menú al pulsar Escape (accesibilidad por teclado).
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && panel.classList.contains('is-open')) {
				toggle.setAttribute('aria-expanded', 'false');
				panel.classList.remove('is-open');
				toggle.focus();
			}
		});
	}
</script>
