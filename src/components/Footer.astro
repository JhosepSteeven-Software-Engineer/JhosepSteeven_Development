---
import { SITE } from '../site.config';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<p class="footer-title">{SITE.name}</p>
		<p class="footer-role">{SITE.role} · {SITE.tagline}</p>

		<SocialLinks layout="row" />

		<p class="footer-legal">
			© {year} {SITE.copyright}. Construido con <a href="https://astro.build/">Astro</a>.
		</p>
	</div>
</footer>

<style>
	footer {
		padding: 3em 1em 5em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}

	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
	}

	.footer-title {
		margin: 0;
		font-weight: 700;
		color: rgb(var(--black));
	}

	.footer-role {
		margin: 0.25rem 0 1.25rem;
		font-size: 0.9rem;
	}

	.footer-legal {
		margin: 1.5rem 0 0;
		font-size: 0.85rem;
	}
</style>
